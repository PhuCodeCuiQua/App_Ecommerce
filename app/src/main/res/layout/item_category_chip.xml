<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/categoryChipCard"
    android:layout_width="@dimen/category_chip_width"
    android:layout_height="@dimen/category_chip_height"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/chip_bg"
    app:cardCornerRadius="@dimen/category_chip_radius"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_8"
        android:paddingTop="@dimen/space_4"
        android:paddingEnd="@dimen/space_8"
        android:paddingBottom="@dimen/space_4">

        <ImageView
            android:id="@+id/imgCategoryIcon"
            android:layout_width="@dimen/category_icon_size"
            android:layout_height="@dimen/category_icon_size"
            android:contentDescription="@null"
            android:src="@drawable/ic_category_grid" />

        <TextView
            android:id="@+id/tvCategoryLabel"
            style="@style/TextAppearance.App.CategoryChip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
