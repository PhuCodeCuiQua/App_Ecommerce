<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/productCard"
    style="@style/Widget.App.Card.Product"
    android:layout_width="@dimen/product_card_width"
    android:layout_height="match_parent"
    android:layout_marginStart="@dimen/space_6"
    android:layout_marginTop="@dimen/space_6"
    android:layout_marginEnd="@dimen/space_6"
    android:layout_marginBottom="@dimen/space_6"
    android:clickable="true"
    android:focusable="true"
    android:clipToOutline="true"
    app:cardBackgroundColor="@color/product_tile"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    app:cardUseCompatPadding="false">

    <LinearLayout
        android:id="@+id/productCardContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/productImageContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/imgProduct"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Ảnh sản phẩm"
                android:padding="0dp"
                android:scaleType="fitCenter" />

            <ImageButton
                android:id="@+id/btnFavorite"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:layout_gravity="top|end"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Bỏ yêu thích"
                android:padding="@dimen/space_12"
                android:src="@drawable/ic_favorite_border"
                android:visibility="gone"
                android:tint="?attr/colorOnSurface" />

            <FrameLayout
                android:id="@+id/btnAdd"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="@dimen/space_12"
                android:layout_marginBottom="@dimen/space_12"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Thêm nhanh vào giỏ hàng"
                android:focusable="true">

                <ImageView
                    android:layout_width="@dimen/quick_add_size"
                    android:layout_height="@dimen/quick_add_size"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_quick_add_button"
                    android:padding="@dimen/space_8"
                    android:src="@drawable/ic_add"
                    android:tint="?attr/colorOnPrimary" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_12"
            android:paddingTop="@dimen/space_8"
            android:paddingEnd="@dimen/space_12"
            android:paddingBottom="@dimen/space_8">

            <TextView
                android:id="@+id/tvProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="@color/tile_text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProductType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/tile_text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvOriginalPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/tile_text"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvDiscount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_4"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="@color/sale_red"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSalePrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="@dimen/product_card_price_max_text_size"
                android:autoSizeMinTextSize="@dimen/product_card_price_min_text_size"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="@color/tile_text"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
