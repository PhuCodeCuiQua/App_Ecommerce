<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/productCard"
    style="@style/Widget.App.Card.Product"
    android:layout_width="@dimen/product_card_width"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/space_6"
    android:layout_marginTop="@dimen/space_6"
    android:layout_marginEnd="@dimen/space_6"
    android:layout_marginBottom="@dimen/space_6"
    android:clickable="true"
    android:focusable="true"
    android:clipToOutline="true"
    app:cardBackgroundColor="@color/product_tile"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    app:cardUseCompatPadding="false">

    <LinearLayout
        android:id="@+id/productCardContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/productImageContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/imgProduct"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="Ảnh sản phẩm"
                android:elevation="@dimen/space_2"
                android:padding="0dp"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvTag"
                style="@style/TextAppearance.App.ProductTag"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/product_tag_height"
                android:layout_margin="@dimen/product_overlay_margin"
                android:drawablePadding="@dimen/space_2"
                android:elevation="@dimen/product_overlay_elevation"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/space_8"
                android:paddingEnd="@dimen/space_8"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/btnFavorite"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:layout_margin="@dimen/product_overlay_margin"
                android:background="@drawable/bg_product_favorite_circle"
                android:contentDescription="Bỏ yêu thích"
                android:elevation="@dimen/product_overlay_elevation"
                android:focusable="false"
                android:padding="@dimen/space_12"
                android:src="@drawable/ic_favorite_border"
                app:tint="@color/tile_text_secondary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_12"
            android:paddingTop="@dimen/space_8"
            android:paddingEnd="@dimen/space_12"
            android:paddingBottom="@dimen/space_8">

            <TextView
                android:id="@+id/tvProductName"
                style="@style/TextAppearance.App.ProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/tile_text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProductType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/tile_text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSalePrice"
                        style="@style/TextAppearance.App.ProductPrice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autoSizeMaxTextSize="@dimen/product_price_text_size"
                        android:autoSizeMinTextSize="@dimen/product_price_min_text_size"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/tile_text" />

                    <LinearLayout
                        android:id="@+id/productDiscountRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvOriginalPrice"
                            style="@style/TextAppearance.App.ProductOriginalPrice"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:autoSizeMaxTextSize="@dimen/product_original_price_text_size"
                            android:autoSizeMinTextSize="@dimen/product_original_price_min_text_size"
                            android:autoSizeTextType="uniform"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvDiscount"
                            style="@style/TextAppearance.App.ProductDiscount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_6"
                            android:background="@drawable/bg_product_discount"
                            android:gravity="center"
                            android:maxLines="1"
                            android:minWidth="@dimen/product_discount_min_width"
                            android:paddingStart="@dimen/space_4"
                            android:paddingEnd="@dimen/space_4" />
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/btnAdd"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:layout_marginStart="@dimen/space_4"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Thêm nhanh vào giỏ hàng"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="@dimen/product_add_visual_size"
                        android:layout_height="@dimen/product_add_visual_size"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_product_add_circle"
                        android:padding="@dimen/space_8"
                        android:src="@drawable/ic_cart"
                        app:tint="@color/white" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
