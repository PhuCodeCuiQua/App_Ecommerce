<resources>
    <style name="Widget.App.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">@dimen/radius_medium</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">@dimen/card_stroke_width</item>
    </style>

    <style name="Widget.App.Card.Product" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/product_tile</item>
        <item name="cardCornerRadius">@dimen/radius_medium</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.App.Card.Notification" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/notification_card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/radius_large</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
    </style>

    <style name="Widget.App.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="backgroundTint">@color/md_primary</item>
        <item name="android:textColor">@color/md_onPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/radius_primary_button</item>
    </style>

    <style name="Widget.App.Button.BuyNow" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/detail_buy_button_height</item>
        <item name="backgroundTint">@color/bottom_bar_black</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
    </style>

    <style name="Widget.App.Button.Pill" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="backgroundTint">@color/chip_size_background_unselected</item>
        <item name="android:textColor">@color/md_onSurface</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
    </style>

    <style name="Widget.App.Button.Pill.Dark" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="backgroundTint">@color/panel_dark</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
    </style>

    <style name="Widget.App.Chip.Size" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_size_background</item>
        <item name="android:textColor">@color/chip_size_text</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:minHeight">@dimen/touch_target</item>
    </style>

    <style name="Widget.App.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/field_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/field_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/field_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/field_radius</item>
    </style>

    <style name="Widget.App.SearchField.Dark" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxCornerRadiusTopStart">@dimen/field_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/field_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/field_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/field_radius</item>
        <item name="boxBackgroundColor">@color/panel_surface</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="hintTextColor">@color/panel_text_secondary</item>
        <item name="startIconTint">@color/white</item>
    </style>

    <style name="Widget.App.BottomNav" parent="" />

    <style name="Widget.App.BottomNav.Item">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/footer_height</item>
        <item name="android:layout_weight">1</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="Widget.App.BottomNav.Content">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Widget.App.BottomNav.Icon">
        <item name="android:layout_width">@dimen/footer_icon_size</item>
        <item name="android:layout_height">@dimen/footer_icon_size</item>
        <item name="android:tint">@color/nav_icon_tint</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="Widget.App.BottomNav.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_2</item>
        <item name="android:textSize">@dimen/nav_label_text_size</item>
        <item name="android:textColor">@color/nav_icon_tint</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="TextAppearance.App.Checkout.TitleSmall"
        parent="TextAppearance.Material3.TitleSmall" />
    <style name="TextAppearance.App.Checkout.BodyMedium"
        parent="TextAppearance.Material3.BodyMedium" />
    <style name="TextAppearance.App.Checkout.BodySmall"
        parent="TextAppearance.Material3.BodySmall" />
    <style name="TextAppearance.App.TitleLarge"
        parent="TextAppearance.Material3.TitleLarge" />
    <style name="TextAppearance.App.TitleMedium"
        parent="TextAppearance.Material3.TitleMedium" />
    <style name="TextAppearance.App.BodyLarge"
        parent="TextAppearance.Material3.BodyLarge" />
    <style name="TextAppearance.App.Banner.Tagline"
        parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/banner_tagline_size</item>
        <item name="android:textColor">@color/banner_tagline</item>
        <item name="android:letterSpacing">0.15</item>
    </style>
    <style name="TextAppearance.App.Banner.Title"
        parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/banner_title_size</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold|italic</item>
    </style>
    <style name="TextAppearance.App.Banner.Subtitle"
        parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/banner_subtitle_size</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">italic</item>
    </style>
    <style name="TextAppearance.App.CategoryChip"
        parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">@dimen/category_label_size</item>
        <item name="android:textColor">@color/tile_text</item>
    </style>
    <style name="TextAppearance.App.ProductTag"
        parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/product_tag_text_size</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.App.ProductName"
        parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">@dimen/product_name_text_size</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.App.ProductDiscount"
        parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/product_discount_text_size</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.App.ProductPrice"
        parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">@dimen/product_price_text_size</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.App.ProductOriginalPrice"
        parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/product_original_price_text_size</item>
        <item name="android:textColor">@color/tile_text</item>
    </style>
    <style name="TextAppearance.App.SectionButton"
        parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/section_button_text_size</item>
    </style>
</resources>
